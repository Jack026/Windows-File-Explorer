{
  "name": "smart-explorer",
  "version": "1.0.0",
  "description": "Native Windows Desktop File Explorer & Visual Storage Analyzer",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -s first \"tsx server/index.ts\" \"vite\"",
    "desktop": "concurrently -k -s first \"tsx server/index.ts\" \"vite\" \"electron .\"",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist-server/index.cjs --external:electron",
    "build": "vite build",
    "build:all": "npm run build && npm run build:server",
    "build:release": "npm run build:all && electron-builder --win",
    "build:exe": "npm run build:all && electron-builder --dir",
    "start": "npm run desktop"
  },
  "keywords": [
    "file-explorer",
    "storage-analyzer",
    "windows",
    "treemap",
    "x-ray"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.72.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
